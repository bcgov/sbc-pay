{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/payment_request",
  "type": "object",
  "title": "Payment Request",
  "required": [
    "businessInfo",
    "filingInfo"
  ],
  "properties": {
    "paymentInfo": {
      "oneOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/payment_info"
        }
      ]
    },
    "businessInfo": {
      "oneOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business_info"
        }
      ]
    },
    "filingInfo": {
      "oneOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_info"
        }
      ]
    },
    "accountInfo": {
      "oneOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/account_info"
        }
      ]
    },
    "details": {
      "oneOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/invoice_details"
        }
      ]
    },
    "skipPayment": {
      "type": "boolean"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "description": "Email address to notify if the payment link is not redeemed. Express-checkout invoices only."
    },
    "returnUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "Partner URL to redirect the payer to after payment. Express-checkout invoices only."
    }
  }
}
